# Copy to .env for local development. Production values live in the host's settings.
NODE_ENV=development
# Local Supabase (`pnpm db:start`). For a hosted project, use the session pooler URL from
# Connect > Session pooler (port 5432) plus ?sslmode=verify-full&sslrootcert=<absolute path
# to the CA certificate> (README "Supabase"). Not the transaction pooler.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# A separate, disposable database: tests truncate every table. Create it with `pnpm db:create-test`.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/base_test
PORT=4000
# Clerk secret key (dashboard > API keys); the API refuses to start without it.
CLERK_SECRET_KEY=
# Admin app (apps/admin): Clerk keys from the same Clerk instance, and where the API runs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
API_URL=http://localhost:4000
