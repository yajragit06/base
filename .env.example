# Copy to .env for local development. Production values live in the host's settings.
NODE_ENV=development
DATABASE_URL=postgres://cms:cms@localhost:5432/cms
TEST_DATABASE_URL=postgres://cms:cms@localhost:5432/cms_test
REDIS_URL=redis://localhost:6379
PORT=4000
# Clerk secret key (dashboard > API keys); the API refuses to start without it.
CLERK_SECRET_KEY=
